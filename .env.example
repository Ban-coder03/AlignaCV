# Copia este archivo a ".env" (cp .env.example .env) y NUNCA lo subas a GitHub.
# Aquí no hay secretos reales: reemplaza los valores de ejemplo.

# --- Modo demo: true = análisis heurístico sin llamar a ninguna API (no requiere clave) ---
USE_MOCK_AI=true

# --- Modo real (USE_MOCK_AI=false): elige proveedor ---
AI_PROVIDER=gemini 

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite   # verifica el nombre vigente en https://ai.google.dev/gemini-api/docs/models

ANTHROPIC_API_KEY=               # https://console.anthropic.com/ (de pago)
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Opcionales (valores por defecto entre paréntesis) ---
# AI_TIMEOUT_SECONDS=60            # timeout por llamada al proveedor
# AI_TOTAL_TIMEOUT_SECONDS=150     # tope total por petición (incluye reintentos)
# AI_SDK_RETRIES=2                 # reintentos de red / 429 / 5xx
# AI_OUTPUT_RETRIES=2              # reintentos si el modelo devuelve JSON inválido
# AI_MAX_OUTPUT_TOKENS=4096
# AI_TEMPERATURE=0.2               # omitir si el modelo no lo admite
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500   # (por defecto: *)
# MAX_UPLOAD_MB=5
# RATE_LIMIT_PER_MINUTE=20         # por IP; 0 = desactivado